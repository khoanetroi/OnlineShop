{
  "rules": {
    "Users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "wishlist": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        },
        "cart": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        },
        "addresses": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },
    "Banner": {
      ".read": true,
      ".write": false
    },
    "Category": {
      ".read": true,
      ".write": false
    },
    "Items": {
      ".read": true,
      ".write": false
    },
    "Orders": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$orderId": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['orderId', 'userId', 'orderDate', 'status', 'items', 'subtotal', 'delivery', 'tax', 'total']) && newData.child('userId').val() === $uid"
        }
      }
    },
    "Reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['reviewId', 'itemId', 'userId', 'userName', 'rating', 'comment'])"
      }
    },
    "AppSettings": {
      ".read": true,
      ".write": false
    },
    "Notifications": {
      "$notificationId": {
        ".read": "data.child('userId').val() === auth.uid",
        ".write": false
      }
    },
    "Coupons": {
      ".read": "auth != null",
      ".write": false
    }
  }
}

