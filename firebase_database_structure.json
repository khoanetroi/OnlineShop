{
  "rules": {
    "Users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "profile": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid",
          ".validate": "newData.hasChildren(['email', 'name'])"
        },
        "wishlist": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid",
          "$itemId": {
            ".validate": "newData.hasChildren(['itemId', 'title', 'price', 'picUrl', 'addedAt'])"
          }
        },
        "cart": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid",
          "$cartItemId": {
            ".validate": "newData.hasChildren(['itemId', 'title', 'price', 'quantity', 'addedAt']) && newData.child('quantity').val() > 0 && newData.child('quantity').val() <= 50"
          }
        },
        "addresses": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid",
          "$addressId": {
            ".validate": "newData.hasChildren(['id', 'fullName', 'phone', 'address', 'city'])"
          }
        }
      }
    },
    "Banner": {
      ".read": true,
      ".write": false
    },
    "Category": {
      ".read": true,
      ".write": false
    },
    "Items": {
      ".read": true,
      ".write": false
    },
    "Orders": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$orderId": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['orderId', 'userId', 'orderDate', 'status', 'items', 'subtotal', 'delivery', 'tax', 'total']) && newData.child('userId').val() === $uid"
        }
      }
    },
    "Reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['reviewId', 'itemId', 'userId', 'userName', 'rating', 'comment'])"
      }
    },
    "AppSettings": {
      ".read": true,
      ".write": false
    },
    "Notifications": {
      "$notificationId": {
        ".read": "data.child('userId').val() === auth.uid",
        ".write": false
      }
    },
    "Coupons": {
      ".read": "auth != null",
      ".write": false
    }
  }
}

